# 단일 프로세스 봇 환경변수 (bot/.env). 실제 값으로 채운 뒤 .env 로 복사.

# Discord 봇 토큰 (게이트웨이 + 서버사이드 REST 둘 다 사용)
BOT_TOKEN=

# 로스트아크 OpenAPI 키 (캐릭터 조회용). 호출 제한 분산용 보조 키는 선택.
LOSTARK_API_KEY=
LOSTARK_API_SUB1_KEY=
LOSTARK_API_SUB2_KEY=

# MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mococobot
DB_PASSWORD=mococobot_dev_password
DB_NAME=mococobot
DB_CHARSET=utf8mb4
DB_AUTOCOMMIT=false
DB_POOL_SIZE=20
DB_POOL_MINSIZE=2
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=5

# 스케줄러/메트릭 튜닝 (선택)
SCHED_LAG_WARN_SEC=10
METRICS_SLOW_QUERY_MS=200
METRICS_QUERY_SAMPLE_RATE=0.05
